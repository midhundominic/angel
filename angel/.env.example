# Copy to .env.local for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Contact form delivery (Resend) ---------------------------------------
# Required. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Must be an address on a domain verified in Resend.
# Use a SUBDOMAIN (mail.heavenfuneralservices.com) so the root-domain SPF
# record used by Cloudflare Email Routing is left untouched.
CONTACT_FROM_EMAIL="Heaven Funeral Services <enquiries@mail.heavenfuneralservices.com>"

# Optional. Defaults to the address in data/site.ts.
CONTACT_TO_EMAIL=woads@heavenfuneralservices.com

# --- Search Console -------------------------------------------------------
# Optional. The token from Search Console → Settings → Ownership verification
# → HTML tag. Paste only the content value, not the whole meta tag.
# Not needed if you verify via the DNS TXT record instead (recommended).
GOOGLE_SITE_VERIFICATION=
